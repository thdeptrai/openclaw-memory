# ============================================================
#  Memolo Memory Server — Environment Configuration
#  Copy this file to server/.env and customize as needed
# ============================================================

# === LLM PROVIDER (minimax or ollama) ===
LLM_PROVIDER=minimax

# === MINIMAX (Cloud LLM — recommended) ===
# Get your API key at: https://platform.minimax.io
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_BASE_URL=https://api.minimax.io/anthropic/v1/messages

# === OLLAMA (Local LLM — alternative) ===
# From inside Docker, use host.docker.internal to reach host's Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=180000

# === SECURITY (REQUIRED for LAN access) ===
# Master API key for admin operations (agent registration, intelligence tasks)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMOLO_MASTER_KEY=change-me-to-a-random-string

# === SERVER ===
PORT=7437
NODE_ENV=development

# === DATABASE (Docker internal — no need to change) ===
PG_HOST=postgres
PG_PORT=5432
PG_USER=openclaw
PG_PASSWORD=openclaw_secret
PG_DATABASE=openclaw_memory

# === QDRANT (Docker internal — no need to change) ===
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# === MEMORY SETTINGS ===
SUMMARIZE_AFTER_EXCHANGES=5
EMBEDDING_DIMENSIONS=4096
